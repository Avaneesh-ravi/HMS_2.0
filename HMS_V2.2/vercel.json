{
  "builds": [
    {
      "src": "router.php",
      "use": "vercel-php@0.7.3",
      "config": {
        "includeFiles": [
          "router.php",
          "frontend/**",
          "api/**/*.php",
          "includes/**/*.php",
          ".env"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/frontend/(.*)", "dest": "/frontend/$1" },
    { "src": "/(.*)", "dest": "/router.php" }
  ]
}
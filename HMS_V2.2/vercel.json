{
  "builds": [
    {
      "src": "router.php",
      "use": "vercel-php@0.9.0",
      "config": {
        "includeFiles": [
          "api/**/*.php",
          "frontend/**",
          "backend/**/*.php",
          "includes/**/*.php"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/router.php"
    }
  ]
}

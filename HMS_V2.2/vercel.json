{
    "functions": {
        "**/*.php": {
            "runtime": "vercel-php@0.9.0"
        }
    },
    "routes": [
        {
            "src": "/frontend/assets/(.*)",
            "dest": "/frontend/assets/$1"
        },
        {
            "src": "/backend/uploads/(.*)",
            "dest": "/backend/uploads/$1"
        },
        {
            "src": "/frontend/?",
            "dest": "/frontend/index.php"
        },
        {
            "src": "/backend/?",
            "dest": "/backend/index.php"
        },
        {
            "src": "/",
            "dest": "/index.php"
        },
        {
            "src": "/(.*)",
            "dest": "/$1"
        }
    ]
}
